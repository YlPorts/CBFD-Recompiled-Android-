+file(GLOB_RECURSE RT64_SHADER_INCLUDES CONFIGURE_DEPENDS
+    "${PROJECT_SOURCE_DIR}/src/shaders/*.hlsli"
+    "${PROJECT_SOURCE_DIR}/src/shared/*.h")
