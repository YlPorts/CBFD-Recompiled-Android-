diff --git a/tools/rt64/src/hle/rt64_screen_modify.h b/tools/rt64/src/hle/rt64_screen_modify.h
new file mode 100644
--- /dev/null
+++ b/tools/rt64/src/hle/rt64_screen_modify.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <array>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+namespace RT64 {
+// A record is [global vertex index, component mask, packed XY, packed Z].
+// One invocation writes each output vertex. Later commands overwrite a pending
+// component, while a clone inherits both components without altering its source.
+// RSP vertex-cache slots are invalidated on load and at each task reset.
+template<std::size_t N> struct ScreenModifyRecords {
+    static constexpr uint32_t Missing=UINT32_MAX;
+    std::array<uint32_t,N> offsets{};
+    uint64_t xyCommands=0,zCommands=0,clones=0,coalesced=0;
+    ScreenModifyRecords() { reset(); }
+    void reset() { offsets.fill(Missing); xyCommands=zCommands=clones=coalesced=0; }
+    void resetSlot(std::size_t slot) { assert(slot<N); offsets[slot]=Missing; }
+    void copySlot(std::size_t slot,uint32_t vertex,std::vector<uint32_t>& words) {
+        assert(slot<N);const uint32_t old=offsets[slot];offsets[slot]=Missing;
+        if(old==Missing || std::size_t(old)+3>=words.size()) return;
+        const uint32_t mask=words[old+1],xy=words[old+2],z=words[old+3];
+        offsets[slot]=uint32_t(words.size());words.insert(words.end(),{vertex,mask,xy,z});++clones;
+    }
+    void update(std::size_t slot,uint32_t vertex,bool z,uint32_t value,std::vector<uint32_t>& words) {
+        assert(slot<N);uint32_t& at=offsets[slot];
+        if(at==Missing || std::size_t(at)+3>=words.size() || words[at]!=vertex) {
+            at=uint32_t(words.size());words.insert(words.end(),{vertex,0,0,0});
+        } else ++coalesced;
+        words[at+1]|=z?2u:1u;words[at+(z?3:2)]=value;
+        if(z) ++zCommands;else ++xyCommands;
+    }
+};
+// F3DEX screen-Z is 16.16 with 10 integer depth bits. RT64's viewport already
+// normalizes those integer bits to [0,1); modify must use the same units.
+inline float normalizedScreenDepth(uint32_t raw) { return float(raw)*(1.0f/67108864.0f); }
+}
