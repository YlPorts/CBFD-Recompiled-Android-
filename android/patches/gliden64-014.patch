diff --git a/src/DisplayWindow.cpp b/src/DisplayWindow.cpp
index 59725f6..25d100b 100644
--- a/src/DisplayWindow.cpp
+++ b/src/DisplayWindow.cpp
@@ -140,6 +140,17 @@ void DisplayWindow::updateScale()
 		return;
 	m_scaleX = static_cast<f32>(m_width) / static_cast<f32>(VI.width);
 	m_scaleY = static_cast<f32>(m_height) / static_cast<f32>(VI.height);
+	// CBFD Android uses a fixed vertical budget. FrameBuffer/DepthBuffer share
+	// one isotropic scale: using the ultrawide window's X ratio would allocate
+	// roughly 1900 vertical pixels for a 1080-line display and downsample them.
+	// Keep 1080 rendered lines; the final VI pass expands to the surface width.
+	if (config.frameBufferEmulation.aspect == Config::aAdjust43) {
+		// VI.height includes GLideN64's VI padding; budget the actual visible
+		// lines so a 1080-line surface also draws 1080 active source lines.
+		if (VI.real_height != 0)
+			m_scaleY = static_cast<f32>(m_height) / static_cast<f32>(VI.real_height);
+		m_scaleX = m_scaleY;
+	}
 }
 
 void DisplayWindow::_setBufferSize()
diff --git a/src/GBI.cpp b/src/GBI.cpp
